{
  "name": "node-smoke",
  "source": "fixtures/node",
  "profile": "node",
  "prepare": [
    "npm install --package-lock-only --ignore-scripts && npm ci"
  ],
  "check": "npm ci --offline --ignore-scripts && npm test",
  "verification": {
    "source": "verification/node",
    "command": "python3 -I /opt/sandbox/verification/check.py node /opt/sandbox/verification/harness.js"
  }
}

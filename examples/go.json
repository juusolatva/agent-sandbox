{
  "name": "go-smoke",
  "source": "fixtures/go",
  "profile": "go",
  "prepare": [
    "go mod download"
  ],
  "check": "GOPROXY=off go test -mod=readonly ./...",
  "verification": {
    "source": "verification/go",
    "command": "GOPROXY=off go build -mod=readonly -o /tmp/harness /opt/sandbox/verification/harness.go && python3 -I /opt/sandbox/verification/check.py /tmp/harness"
  }
}

{
  "name": "rust-smoke",
  "source": "fixtures/rust",
  "profile": "rust",
  "prepare": [
    "cargo generate-lockfile && cargo fetch --locked"
  ],
  "check": "cargo test --frozen && cargo clippy --frozen -- -D warnings",
  "verification": {
    "source": "verification/rust",
    "command": "cargo build --frozen && rustc /opt/sandbox/verification/harness.rs --extern sandbox_smoke=/tmp/cargo-target/debug/libsandbox_smoke.rlib -L dependency=/tmp/cargo-target/debug/deps -o /tmp/harness && python3 -I /opt/sandbox/verification/check.py /tmp/harness"
  }
}

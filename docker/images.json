{
  "cpp": {"target": "cpp", "probe": "gcc-12 --version && clang-19 --version"},
  "go": {"target": "go", "probe": "go version && staticcheck -version"},
  "rust": {"target": "rust", "probe": "rustc --version && cargo --version"},
  "python313": {"target": "python", "args": {"PYTHON_IMAGE": "python:3.13.18-slim-trixie"}, "probe": "python3 --version && ruff --version && python3 -c \"import hypothesis\""},
  "python314": {"target": "python", "args": {"PYTHON_IMAGE": "python:3.14.10-slim-trixie"}, "probe": "python3 --version && ruff --version && python3 -c \"import hypothesis\""},
  "node": {"target": "node", "probe": "node --version && npm --version && eslint --version"}
}

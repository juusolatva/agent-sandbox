# Copy to .env (ignored by Git) and adjust. Docker Compose reads it automatically.

# Address the llm-proxy container uses to reach your OpenAI-compatible server. Required.
# host.docker.internal works on Docker Desktop and Linux (mapped via host-gateway);
# in mirrored-network setups (such as WSL2) you may need your host or gateway IP instead.
LLM_HOST=host.docker.internal
LLM_PORT=1234

# Model ID served by your inference endpoint. Required by agent.py; choose it explicitly.
LLM_MODEL=your-model-id

# Optional API key if your inference server requires authentication.
#OPENAI_API_KEY=local

# Optional run limits (defaults shown).
#MAX_ITERATIONS=20
#MAX_HISTORY_MESSAGES=24
#MAX_CONTEXT_TOKENS=12000
#MAX_SUMMARY_CHARS=3000
#COMMAND_TIMEOUT=30
#LLM_TIMEOUT=120
#VERIFY_CMD=
#CONTINUOUS=0

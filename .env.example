# Copy to .env (ignored by Git) and adjust. Docker Compose reads it automatically.

# Address the lm-proxy container uses to reach LM Studio. Required.
# 10.0.0.2 is the WSL2 mirrored-networking host address this project was tested with.
LM_STUDIO_HOST=10.0.0.2
LM_STUDIO_PORT=1234

# LM Studio model ID. Required by agent.py; choose it explicitly.
LLM_MODEL=google/gemma-4-12b

# Optional run limits (defaults shown).
#MAX_ITERATIONS=20
#MAX_HISTORY_MESSAGES=24
#COMMAND_TIMEOUT=30
#LLM_TIMEOUT=120
#VERIFY_CMD=
#CONTINUOUS=0
